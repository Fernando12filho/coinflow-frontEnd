# CoinFlow Frontend Environment Variables

# Port for the development server (default is 3000)
PORT=3000

# Backend API URL
# Use this for local development:
REACT_APP_API_URL=http://127.0.0.1:5000
# Use this for production:
# REACT_APP_API_URL=https://coinflow-backend.onrender.com

# Browser auto-open on start
BROWSER=none

# Disable source maps in production (optional)
GENERATE_SOURCEMAP=true
